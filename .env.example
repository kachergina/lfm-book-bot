# School Books Marketplace Bot - Environment Configuration
# Copy this file to .env and fill in the required values.

# Telegram Bot Token (required)
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Environment: development | production
ENVIRONMENT=development

# Database URL (required)
# SQLite for development:
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db
# PostgreSQL for production:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/school_books_bot

# Admin Telegram IDs (comma-separated)
# Users with these IDs will have admin privileges
BOT_ADMIN_IDS=

# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Listing configuration
MAX_LISTINGS_PER_USER=50
LISTING_EXPIRY_DAYS=180